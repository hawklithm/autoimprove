{
  "version": "1.1",
  "confidence_thresholds": {
    "repeated-correction": 0.45,
    "anti-pattern": 0.45,
    "preference": 0.3,
    "performance": 0.4,
    "security": 0.3
  },
  "confidence_weights": {
    "frequency": 0.3,
    "time_span": 0.1,
    "behavior": 0.4,
    "validation": 0.2
  },
  "rule_matching": {
    "max_results": 10,
    "min_confidence": 0.3
  },
  "business_domain_mappings": {},
  "rule_generation": {
    "use_template_generation": true,
    "template_hot_reload": true
  },
  "local_ml": {
    "enabled": false,
    "embedding_backend": "char-ngram-tfidf",
    "prefilter": {
      "enabled": false,
      "mode": "heuristic"
    },
    "clusterer": "legacy",
    "pattern_clusterer": "legacy",
    "signal_match": {
      "mode": "legacy",
      "threshold": 0.62
    },
    "personalization": {
      "enabled": false,
      "per_user": false
    },
    "ab_test": {
      "rollout": 0
    }
  }
}

